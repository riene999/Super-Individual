{
  "name": "super-individual",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:py-api": "cd apps/api_py && uv run uvicorn app.main:app --host 0.0.0.0 --port 3001 --reload",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test:recall-prefill": "pnpm --filter @super-individual/e2e exec tsx test-recall-prefill.ts",
    "test:all": "pnpm test:recall-prefill"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
